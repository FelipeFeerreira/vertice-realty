# ─────────────────────────────────────────────────────────────
# Vertice Realty — environment template
# Copy to `.env` and fill in values. The app runs 100% in DEMO
# MODE when optional integrations are left empty.
# ─────────────────────────────────────────────────────────────

# Database (SQLite for local development — keep as is)
DATABASE_URL="file:./dev.db"

# ── Optional: real AI mode ──────────────────────────────────
# When set, the concierge uses an LLM to phrase its replies.
# Qualification logic, scoring and matching ALWAYS remain
# deterministic server-side code.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ── Optional: automation / CRM webhook ──────────────────────
# Generic outbound webhook (n8n / Make / Zapier catch-hook).
# Receives the qualified-lead payload. Empty = simulated.
AUTOMATION_WEBHOOK_URL=""

# ── Optional: WhatsApp agent alerts ─────────────────────────
# Webhook that receives the agent notification message
# (e.g. n8n workflow → Meta WhatsApp Cloud API / Twilio).
WHATSAPP_WEBHOOK_URL=""
AGENT_WHATSAPP_NUMBER="+5511999990000"

# ── Optional: transactional email (Resend) ──────────────────
# Outbound email webhook; the workflow owns provider credentials.
EMAIL_WEBHOOK_URL=""
# Reserved for a future direct provider adapter; not used by this demo.
EMAIL_API_KEY=""
EMAIL_FROM="Vertice Realty <hello@verticerealty.com.br>"

# ── Optional: Google Calendar ───────────────────────────────
GOOGLE_CALENDAR_ID=""
GOOGLE_CALENDAR_WEBHOOK_URL=""

# Public origin for metadata and sitemap (no trailing slash).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Show the public portfolio-demo notice. Keep false for local recordings.
NEXT_PUBLIC_DEMO_MODE="false"
